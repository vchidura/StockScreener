# Virtual environments
.venv/
venv/
backend/.venv/

# Build artifacts
build/
dist/
*.egg-info/
*.tsbuildinfo
.eslintcache

# --- Scratch and generated output ---
# A leading underscore marks a throwaway probe or audit, not a durable script. Findings
# belong in docs/ or the register; the script that produced them does not.
backend/_*.py
backend/scripts/_*.py

# Default raw provider archive. Parquet objects are retained market data, not source.
backend/option-raw/

# Daily performance artifacts accumulate one file per session and would churn the repo.
# They are regenerated by report_option_performance.py from the outcome tables.
docs/option_performance/

# Local database backup media
backend/backups/*.dump
backend/backups/*.partial
backend/backups/*.dump.partial

# Study working data. Event files reach hundreds of megabytes and are
# reproducible from retained bars, universes and versioned detectors; the small
# JSON reports beside them are the durable record and stay tracked.
backend/backups/**/*.jsonl
backend/backups/**/*.log
backend/backups/**/*.err
backend/backups/**/*.parquet
backend/backups/**/*.csv
backend/backups/**/*.ndjson

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/

# --- Local environment files (do not commit secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.production
frontend/.env.local

# Keep safe/shared templates tracked
!.env.example
!backend/.env.example
!frontend/.env.production

# --- Temporary / cache ---
*.tmp
*.temp
.cache/
*.sqlite
*.sqlite3
*.prof
*.trace

# One-time research/cutover report outputs
docs/equity_*parity*.json
docs/equity_portal_cutover_soak.json
backend/research/fibonacci_scoring_*.json
backend/research/scanner_confidence_study.json
