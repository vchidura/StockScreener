# Virtual environments
.venv/
venv/
backend/.venv/

# Build artifacts
build/
dist/
*.egg-info/
*.tsbuildinfo
.eslintcache

# --- Scratch and generated output ---
# A leading underscore marks a throwaway probe or audit, not a durable script. Findings
# belong in docs/ or the register; the script that produced them does not.
backend/_*.py
backend/scripts/_*.py

# Default raw provider archive. Parquet objects are retained market data, not source.
backend/option-raw/

# Local documentation and research artifacts. Required program inputs live in backend/research/inputs/.
/docs/

# Local backups, forward state and study artifacts are retained outside Git.
backend/backups/

# Full original source copies are local rollback material, not application code.
/legacy/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/

# --- Local environment files (do not commit secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.production
frontend/.env.local

# Keep safe/shared templates tracked
!.env.example
!backend/.env.example
!frontend/.env.production

# --- Temporary / cache ---
*.tmp
*.temp
.cache/
*.sqlite
*.sqlite3
*.prof
*.trace

# One-time research/cutover report outputs
backend/research/fibonacci_scoring_*.json
backend/research/scanner_confidence_study.json
