# --- Local environment files (do not commit secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local

# Keep safe/shared templates tracked
!.env.example
!backend/.env.example
!frontend/.env.production

# --- Temporary / cache ---
*.tmp
*.temp
.cache/
