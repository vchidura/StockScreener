# --- Scratch and generated output ---
# A leading underscore marks a throwaway probe or audit, not a durable script. Findings
# belong in docs/ or the register; the script that produced them does not.
backend/_*.py
backend/scripts/_*.py

# Default raw provider archive. Parquet objects are retained market data, not source.
backend/option-raw/

# Local documentation and research artifacts. Required program inputs live in backend/research/inputs/.
/docs/*
!/docs/ADVANCED_REALTIME_PREFLIGHT_DESIGN.md
!/docs/ADVANCED_REALTIME_IMPLEMENTATION_PLAN.md
!/docs/ADVANCED_REALTIME_IMPLEMENTATION_TRACKER.md

# Local working specs. Routed agent context lives in .github/copilot-instructions.md.
/.github/specs/

# Local backups, forward state and study artifacts are retained outside Git.
backend/backups/

# Full original source copies are local rollback material, not application code.
/legacy/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/

# --- Local environment files (do not commit secrets) ---
.env
.env.realtime
.env_old_donot_use
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.production
backend/.env.realtime.local
backend/.realtime-canary/
frontend/.env.local

