# Database Configuration
# DB_USER and DB_PASSWORD are REQUIRED - app will fail without them
DB_NAME=stocks_db
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Data Provider API (required for scheduled updates)
# Get a free key at: https://twelvedata.com/ (800 calls/day)
TWELVEDATA_API_KEY=your_api_key_here

# Polygon.io / massive.com API (optional — enables --provider polygon)
# Subscribe to a Stocks plan at https://massive.com/pricing (Starter: unlimited
# calls, 15-min delayed data, 5 years history). Get your key from the dashboard.
POLYGON_API_KEY=your_polygon_api_key_here

# Optional: API Settings
# CORS_ORIGINS=http://localhost:5174,https://yourdomain.com
