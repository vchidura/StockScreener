# Required runtime configuration
APP_ENV=development
DB_NAME=stocks_db_fresh
DB_USER=stock_screener_app
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
POLYGON_API_KEY=your_polygon_api_key_here
# Optional free personal-use earnings calendar source.
# FINNHUB_API_KEY=your_finnhub_api_key_here
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Required only for fresh DB/schema initialization. Must differ from DB_USER.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=your_admin_password

# Initial universe policy
EQUITY_UNIVERSE_TARGET_SIZE=350
EQUITY_UNIVERSE_LOOKBACK_DAYS=20

# Provider entitlement timing; change only when the subscribed plan changes.
EQUITY_PROVIDER_DELAY_MINUTES=15
OPTION_PROVIDER_DELAY_SECONDS=900

# Explicit safety gates; do not change until their acceptance criteria pass.
OPTION_RAW_ARCHIVE_ENABLED=false
OPTION_START_READ_ONLY=true
OPTION_EQUITY_CONTEXT_ENABLED=false
# Set only after importing matching point-in-time events and coverage.
# OPTION_EVENT_CALENDAR_PROVIDER=public_calendar_v1
# OPTION_EVENT_CALENDAR_MAX_AGE_SECONDS=43200
# Enabling this multiplies provider requests per cycle by the watchlist size.
OPTION_TRADE_INGESTION_ENABLED=false
# A run further behind its slot than this degrades the matrix instead of selecting from it.
OPTION_MAXIMUM_EXECUTION_LAG_SECONDS=1800

# Explicit model assumptions used in option configuration fingerprints.
OPTION_STARTING_CASH=250000
OPTION_RISK_FREE_RATE=0.04
OPTION_RISK_FREE_RATE_SOURCE=manual_config_v1
# Set after corporate-action coverage has been seeded and validated.
# OPTION_DIVIDEND_INPUT_SOURCE=polygon_corporate_actions_v1
# OPTION_DIVIDEND_INPUT_MAX_AGE_SECONDS=43200
OPTION_VALUATION_POLICY_FILE=options/policies/valuation_v1.json
# OPTION_SETTLEMENT_VALUATION_POLICY_FILE=options/policies/settlement_valuation_v1.json

# Optional tuning overrides. Omit to use tested defaults.
# EQUITY_NATIVE_FETCH_WORKERS=8
# EQUITY_WORKER_POLL_SECONDS=15
# EQUITY_CORPORATE_ACTION_POLL_SECONDS=21600
# EQUITY_CORPORATE_ACTION_LOOKBACK_DAYS=30
# EQUITY_CORPORATE_ACTION_HORIZON_DAYS=365
# EQUITY_CORPORATE_ACTION_RETRY_SECONDS=300
# EQUITY_STALE_RUN_MINUTES=60
# EQUITY_PORTAL_SNAPSHOT_POLL_SECONDS=60
# OPTION_WORKER_POLL_SECONDS=15
# MARKET_EVENT_POLL_SECONDS=21600
# MARKET_EVENT_LOOKBACK_DAYS=1
# MARKET_EVENT_HORIZON_DAYS=45
# OPTION_MODEL_INPUT_POLL_SECONDS=21600
# OPTION_MODEL_INPUT_RETRY_SECONDS=300
# OPTION_SLOT_SECONDS=900
# OPTION_PUBLICATION_GRACE_SECONDS=30
# OPTION_FIXED_STOCK_UNDERLYERS=AAPL,AMD,AMZN,GOOGL,META,MSFT,NVDA,PLTR,SOFI,TSLA
# OPTION_FIXED_ETF_UNDERLYERS=SPY,QQQ,IWM
# OPTION_STOCK_UNIVERSE_SIZE=10
# OPTION_ETF_UNIVERSE_SIZE=3
# OPTION_TRADE_WATCHLIST_PER_UNDERLYER=15
# OPTION_TRADE_LOOKBACK_SECONDS=3600
# OPTION_TRADE_INGESTION_BUDGET_SECONDS=120
# OPTION_GAMMA_POLICY_FILE=options/policies/gamma_policy_v1.json
