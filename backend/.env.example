# Required runtime configuration
APP_ENV=development
DB_NAME=stocks_db_fresh
DB_USER=stock_screener_app
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
POLYGON_API_KEY=your_polygon_api_key_here
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Required only for fresh DB/schema initialization. Must differ from DB_USER.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=your_admin_password

# Initial universe policy
EQUITY_UNIVERSE_TARGET_SIZE=350
EQUITY_UNIVERSE_LOOKBACK_DAYS=20

# Provider entitlement timing; change only when the subscribed plan changes.
EQUITY_PROVIDER_DELAY_MINUTES=15
OPTION_PROVIDER_DELAY_SECONDS=900

# Explicit safety gates; do not change until their acceptance criteria pass.
OPTION_RAW_ARCHIVE_ENABLED=false
OPTION_START_READ_ONLY=true
OPTION_EQUITY_CONTEXT_ENABLED=false

# Explicit model assumptions used in option configuration fingerprints.
OPTION_STARTING_CASH=250000
OPTION_RISK_FREE_RATE=0.04
OPTION_RISK_FREE_RATE_SOURCE=manual_config_v1

# Optional tuning overrides. Omit to use tested defaults.
# EQUITY_NATIVE_FETCH_WORKERS=8
# EQUITY_WORKER_POLL_SECONDS=15
# EQUITY_STALE_RUN_MINUTES=60
# EQUITY_PORTAL_SNAPSHOT_POLL_SECONDS=60
# OPTION_WORKER_POLL_SECONDS=15
# OPTION_SLOT_SECONDS=900
# OPTION_PUBLICATION_GRACE_SECONDS=30
# OPTION_FIXED_STOCK_UNDERLYERS=AAPL,AMD,AMZN,GOOGL,META,MSFT,NVDA,PLTR,SOFI,TSLA
# OPTION_FIXED_ETF_UNDERLYERS=SPY,QQQ,IWM
# OPTION_STOCK_UNIVERSE_SIZE=10
# OPTION_ETF_UNIVERSE_SIZE=3
