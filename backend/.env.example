# Database Configuration
# DB_USER and DB_PASSWORD are REQUIRED - app will fail without them
DB_NAME=stocks_db
DB_USER=your_db_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Data Provider API (required for scheduled updates)
# Get a free key at: https://twelvedata.com/ (800 calls/day)
TWELVEDATA_API_KEY=your_api_key_here

# Polygon.io / massive.com API (optional — enables --provider polygon)
# Subscribe to a Stocks plan at https://massive.com/pricing (Starter: unlimited
# calls, 15-min delayed data, 5 years history). Get your key from the dashboard.
POLYGON_API_KEY=your_polygon_api_key_here

# Polygon Options Developer pipeline (Phase 1 starts read-only)
OPTION_DATA_ENGINE=polygon_developer
OPTION_UNDERLYING_DATA_PROVIDER=polygon_stocks
# OPTION_EVENT_CALENDAR_PROVIDER=select_before_phase_2
OPTION_EXECUTION_ENGINE=paper_proxy
OPTION_UNIVERSE_MODE=fixed
OPTION_FIXED_STOCK_UNDERLYERS=AAPL,AMD,AMZN,GOOGL,META,MSFT,NVDA,PLTR,SOFI,TSLA
OPTION_FIXED_ETF_UNDERLYERS=SPY,QQQ,IWM
OPTION_STOCK_UNIVERSE_SIZE=10
OPTION_ETF_UNIVERSE_SIZE=3
OPTION_POLL_SECONDS=900
OPTION_STARTING_CASH=250000
OPTION_RISK_FREE_RATE=0.04
OPTION_RISK_FREE_RATE_SOURCE=manual_config_v1
OPTION_DEFAULT_DIVIDEND_YIELD=0
OPTION_POLICY_FILE=options/policies/developer_v1.json
OPTION_STRATEGY_POLICY_FILE=options/policies/strategy_v1.json
OPTION_RAW_ARCHIVE_ENABLED=false
OPTION_RAW_ARCHIVE_ROOT=option-raw
OPTION_START_READ_ONLY=true

# Optional: API Settings
# CORS_ORIGINS=http://localhost:5174,https://yourdomain.com
