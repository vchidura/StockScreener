# Realtime V2 pipeline selection. Selection is explicit and fail-closed; an
# Advanced failure never silently starts the Developer provider path.
REALTIME_V2_EQUITY_PIPELINE=MASSIVE_ADVANCED
REALTIME_V2_OPTIONS_PIPELINE=DISABLED

# Persistent hardened V2 login DSNs. Generate them with
# provision_realtime_v2_credentials.py; never use the PostgreSQL admin login.
REALTIME_V2_APP_DSN=replace_with_generated_value
REALTIME_V2_API_DSN=replace_with_generated_value

# Exact Advanced Stocks runtime catalog.
REALTIME_V2_ADVANCED_JOURNAL_DIR=C:\replace_with_local_non_synced_path\advanced-equity
REALTIME_V2_ADVANCED_INGRESS_POLICY_PATH=C:\replace_with_repository_path\backend\realtime\policies\advanced_equity_ingress_v1.json
REALTIME_V2_ADVANCED_INGRESS_POLICY_VERSION=advanced-equity-ingress-v1

# Isolated Advanced Realtime configuration.
# Copy only the entries required by the process being run. Never copy the
# canonical DB_NAME, DB_USER, DB_PASSWORD, application flags, or CORS settings.

# Generated by provision_realtime_database.py --initialize-local-secrets.
# Each DSN must name stocks_realtime_v1 and its matching generated principal.
REALTIME_MIGRATOR_PASSWORD=replace_with_generated_value
REALTIME_RUNTIME_PASSWORD=replace_with_generated_value
REALTIME_API_PASSWORD=replace_with_generated_value
REALTIME_MIGRATOR_DSN=postgresql://stocks_realtime_migrator:replace_with_generated_value@127.0.0.1:5432/stocks_realtime_v1
REALTIME_RUNTIME_DSN=postgresql://stocks_realtime_runtime:replace_with_generated_value@127.0.0.1:5432/stocks_realtime_v1
REALTIME_API_DSN=postgresql://stocks_realtime_api:replace_with_generated_value@127.0.0.1:5432/stocks_realtime_v1

# Standalone realtime API. The portal proxies its full /api namespace here.
REALTIME_API_HOST=127.0.0.1
REALTIME_API_PORT=8002

# Required only by explicitly authorized provider-backed realtime jobs.
POLYGON_API_KEY=replace_with_provider_value
FINNHUB_API_KEY=replace_with_provider_value

# Required only by provisioning, migration, security and read-only admin audits.
DB_HOST=127.0.0.1
DB_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace_with_admin_value

# Optional reviewed policy overrides. Omit to use repository defaults.
# OPTION_POLICY_FILE=options/policies/developer_v1.json
# OPTION_VALUATION_POLICY_FILE=options/policies/valuation_v1.json