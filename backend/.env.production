# Production Environment Configuration
# Copy to .env.production and update with production values

# Database Configuration (use Docker service name 'db' when using docker-compose)
DB_NAME=stocks_db
DB_USER=postgres
DB_PASSWORD=your_secure_production_password
DB_HOST=db
DB_PORT=5432

# Data Provider APIs
TWELVEDATA_API_KEY=your_twelvedata_api_key
FINNHUB_API_KEY=your_finnhub_api_key

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8001
