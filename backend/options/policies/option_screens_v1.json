        {"not": {"field": "calendar_dte", "op": "in", "value": [3, 4]}},
        {"field": "day_volume", "op": ">=", "parameter": "minimum_day_volume"},
        {"field": "day_premium", "op": ">=", "parameter": "minimum_day_premium"}
      ]},
      "parameters": {
        "underlying_tiers": {
          "SPY": "ETF", "QQQ": "ETF", "IWM": "ETF",
          "AAPL": "CORE_MEGA_CAP", "AMZN": "CORE_MEGA_CAP", "MSFT": "CORE_MEGA_CAP",
          "NFLX": "HIGH_BETA_HIGH_PREMIUM", "NVDA": "HIGH_BETA_HIGH_PREMIUM", "TSLA": "HIGH_BETA_HIGH_PREMIUM"
        },
        "values": {
          "ETF": {"minimum_day_volume": 5000, "minimum_day_premium": 1000000},
