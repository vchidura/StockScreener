  "screens": [
    {
      "schema_version": "options-screen-v1",
      "id": "unusual-activity-calls",
      "version": 1,
      "name": "Unusual activity: calls",
      "summary": "Calls trading at least 3 times their prior open interest, with tier-sized volume and premium. An observation of activity: it does not show buying, opening flow or direction.",
      "contract_type": "CALL",
      "rule": {"all": [
        {"field": "open_interest", "op": ">=", "value": 500},
